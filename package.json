{
  "name": "keepmind",
  "version": "0.1.1",
  "description": "KeepMind \u2014 open-source installable second brain. Connects your apps, remembers everything, learns while you sleep.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "bin": {
    "keepmind-mcp": "./tools/keepmind-mcp.mjs",
    "keepmind-cli": "./tools/keepmind-cli.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "start:headless": "electron-vite build && xvfb-run -a env SECOND_BRAIN_HEADLESS=1 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "electron-updater": "^6.8.11",
    "libsodium-wrappers": "^0.8.4",
    "libsodium-wrappers-sumo": "^0.8.4",
    "onnxruntime-node": "^1.31.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "author": "KeepMind contributors",
  "files": [
    "out/",
    "tools/keepmind-mcp.mjs",
    "README.md",
    "NOTICE",
    "LICENSE",
    "src/main/vendor/laya/LICENSE.laya",
    "tools/keepmind-cli.mjs"
  ]
}
